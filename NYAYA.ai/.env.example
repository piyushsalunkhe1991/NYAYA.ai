# Copy to backend/.env  (all values optional - defaults shown)
AI_BASE_URL=https://api.llmfaucet.dev/v1
AI_MODEL=auto
# LLMFaucet is anonymous: leave AI_API_KEY empty.
AI_API_KEY=
AI_TIMEOUT=60
# The account registered with this e-mail becomes the Admin.
ADMIN_EMAIL=admin@nyaya.ai
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,http://localhost:5500,http://127.0.0.1:5500
